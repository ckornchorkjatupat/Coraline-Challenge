meta {
  name: Play Game
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/game/game/play
  body: json
  auth: inherit
}

body:json {
  {
    "action": "ROCK"
  }
}

tests {
  test('should return status 201', () => {
    expect(res.getStatus()).to.equal(201);
  });
  
  test('should return botAction', () => {
    const body = res.getBody();
    expect(body).to.have.property('botAction');
    expect(['ROCK', 'PAPER', 'SCISSORS']).to.include(body.botAction);
  });
  
  test('should return result', () => {
    const body = res.getBody();
    expect(body).to.have.property('result');
    expect(['WIN', 'LOSE', 'DRAW']).to.include(body.result);
  });
}
